{
  "type": "object",
  "required": ["schema_version", "doc", "verdict", "closed", "completion_pct", "open_questions",
               "expected_anchors", "missing_anchors", "unsupported_checks", "inventions", "corrections_to_paste"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "doc": {"type": "string"},
    "verdict": {"type": "string", "enum": ["approved", "changes_required", "approved_by_human", "rejected_by_human"]},
    "closed": {"type": "boolean"},
    "completion_pct": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "expected_anchors": {"type": "array", "items": {"type": "string"}},
    "missing_anchors": {"type": "array", "items": {"type": "string"}},
    "unsupported_checks": {"type": "array", "items": {"type": "object", "required": ["line", "text"]}},
    "inventions": {"type": "array", "items": {"type": "object", "required": ["term", "line", "text", "source"]}},
    "corrections_to_paste": {"type": "string"},
    "editor_fixes": {"type": "array", "items": {"type": "object", "required": ["section", "replace_with", "reason"]}},
    "decision": {"type": "object", "required": ["by", "author", "verdict", "reason", "at", "overrides"],
                 "properties": {"by": {"enum": ["human"]}, "author": {"type": "string"},
                                "verdict": {"enum": ["approved", "rejected"]}, "reason": {"type": "string", "minLength": 1},
                                "at": {"type": "string"}, "overrides": {"enum": ["changes_required"]}}},
    "pb_changes": {"type": ["array", "null"],
                   "items": {"type": "object", "required": ["op", "section", "text"]}}
  }
}
