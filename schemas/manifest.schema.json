{
  "type": "object",
  "required": [
    "schema_version",
    "plan",
    "epics"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "plan": {
      "type": "object",
      "required": [
        "id",
        "title",
        "created",
        "readiness",
        "export"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9]{4}-[a-z0-9-]+$"
        },
        "title": {
          "type": "string"
        },
        "created": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "readiness": {
          "type": "object",
          "required": [
            "verdict",
            "rounds"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                null,
                "approved",
                "changes_required",
                "hitl"
              ]
            },
            "rounds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          }
        },
        "export": {
          "type": "object",
          "required": [
            "frozen",
            "at",
            "epics"
          ],
          "additionalProperties": false,
          "properties": {
            "frozen": {
              "type": "boolean"
            },
            "at": {
              "type": [
                "string",
                "null"
              ]
            },
            "epics": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$"
              }
            }
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "greenfield",
            "brownfield"
          ]
        }
      }
    },
    "epics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "done_when",
          "tasks"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E[0-9]+$"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "draft"
            ]
          },
          "title": {
            "type": "string"
          },
          "done_when": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^E[0-9]+\\.C[0-9]+: "
            }
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "acceptance",
                "depends_on",
                "subtasks",
                "estimate",
                "priority",
                "labels"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+$"
                },
                "title": {
                  "type": "string"
                },
                "acceptance": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^AC[0-9]+: "
                  }
                },
                "depends_on": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "subtasks": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "object"
                    ],
                    "required": [
                      "title"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "purpose": {
                        "type": "string"
                      },
                      "how_to": {
                        "type": "string"
                      },
                      "component": {
                        "type": "string",
                        "pattern": "^(FE|BE|BO|QA|DEVOPS|INFRA|BFF|AI)(/(FE|BE|BO|QA|DEVOPS|INFRA|BFF|AI))*$"
                      },
                      "story_points": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "requirements": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "estimate": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "priority": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    null,
                    "high",
                    "medium",
                    "low"
                  ]
                },
                "labels": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "component": {
                  "type": "string",
                  "pattern": "^(FE|BE|BO|QA|DEVOPS|INFRA|BFF|AI)(/(FE|BE|BO|QA|DEVOPS|INFRA|BFF|AI))*$"
                },
                "story": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "user_story_text": {
                      "type": "string"
                    },
                    "context_and_need": {
                      "type": "string"
                    },
                    "scope": {
                      "type": "string"
                    },
                    "out_of_scope": {
                      "type": "string"
                    },
                    "technical_info": {
                      "type": "string"
                    },
                    "assumptions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "business_rules": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "edge_cases": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "assets": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "product": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "objective": {
                "type": "string"
              },
              "problem": {
                "type": "string"
              },
              "strategic_objective": {
                "type": "string"
              },
              "expected_impact": {
                "type": "string"
              },
              "out_of_scope": {
                "type": "string"
              },
              "insights": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "assumptions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "related_documents": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "start_date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "end_date_estimated": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "quarter": {
                "type": "string",
                "pattern": "^Q[1-4]/[0-9]{4}$"
              },
              "criticality": {
                "type": "string",
                "enum": [
                  "Alta",
                  "Media",
                  "Baja"
                ]
              },
              "priority": {
                "type": "string",
                "enum": [
                  "Alta",
                  "Media",
                  "Baja"
                ]
              },
              "big_move": {
                "type": "boolean"
              },
              "owner": {
                "type": "string"
              },
              "vertical": {
                "type": "string"
              },
              "technical_context": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
